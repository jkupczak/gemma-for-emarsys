{
  "name": "Gemma for Emarsys",
  "version": "14.2.2",
  "manifest_version": 3,
  "description": "Enhances the Emarsys email editor with a settings panel and more!",
  "permissions": ["storage", "tabs", "webNavigation"],
  "host_permissions": [
    "https://*.emarsys.net/*",
    "https://*.gservice.emarsys.net/*",
    "https://*.cf.emarsys.net/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gemma for Emarsys"
  },
  "icons": {
    "512": "icons/icon-512x512.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["img/*", "css--theme.css", "css--global-styles.css", "css--media-database.css", "custom-paste.js", "debug-logging-page-bridge.js", "campaign-draft-data.js", "campaign-links-data.js", "content-blocks-fetch-bridge.js", "gem-snippet-iframe-bridge.js"],
      "matches": ["https://*.emarsys.net/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://*.emarsys.net/*"],
      "exclude_matches": ["https://*.emarsys.net/*gemStripped=true*"],
      "js": ["debug-logging-page-bridge.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.emarsys.net/*"],
      "exclude_matches": ["https://*.emarsys.net/*gemStripped=true*"],
      "css": ["css--theme.css", "css--global-styles.css", "css--settings-panel.css", "css--command-palette.css"],
      "js": ["debug-logging-gate.js", "gem-dom-watch.js", "emarsys-auth.js", "page-localstorage-guard.js", "platform.js", "gem-layer-stack.js", "nav-menu-utils.js", "command-palette.js", "highlight-terms-settings.js", "keyboard-shortcuts-modal.js", "theme-applier.js", "gem-toast.js", "shortcut-slots.js", "settings-panel.js", "nav-menu-inject.js", "notes.js", "recent-campaigns.js", "recent-segments.js", "storage-measurement.js", "welcome-modal.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.emarsys.net/bootstrap.php?*r=MediaDB/popup*"],
      "js": ["debug-logging-gate.js", "gem-dom-watch.js", "media-db-popup.js"],
      "css": ["css--MediaDB-popup.css"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.emarsys.net/bootstrap.php?*r=customer/Login/Relogin*"],
      "js": ["debug-logging-gate.js", "gem-dom-watch.js", "relogin-auto-select.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.emarsys.net/bootstrap.php?*r=emailCampaignList/index*"],
      "css": ["css--email-campaign-list.css"],
      "js": ["debug-logging-gate.js", "platform.js", "gem-toast.js", "email-campaign-list.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://client-version.cf.emarsys.net/rti-node-dialog/latest/ac-send-email.html*"],
      "css": ["css--rti-send-email.css"],
      "js": ["debug-logging-gate.js", "gem-dom-watch.js", "rti-send-email.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.emarsys.net/preview_fs.php?*camp_id=*",
        "https://*.emarsys.net/bootstrap.php?*camp_id=*&*r=preview*",
        "https://*.emarsys.net/bootstrap.php?*r=preview*&*camp_id=*"
      ],
      "css": ["css--theme.css", "css--global-styles.css", "css--preview-fs.css"],
      "js": ["theme-applier.js", "preview-fs.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.emarsys.net/preview_fs_iframe.php?*camp_id=*"],
      "js": ["preview-fs-iframe-bridge.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.emarsys.net/bootstrap.php?*r=eventCenter/index*"],
      "css": ["css--event-center.css"],
      "js": ["debug-logging-gate.js", "gem-dom-watch.js", "event-center.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.emarsys.net/bootstrap.php?*r=contentBlocks/campaign*gemStripped=true*",
        "https://*.emarsys.net/bootstrap.php?*gemStripped=true*r=contentBlocks/campaign*",
        "https://*.emarsys.net/bootstrap.php?*r=contentBlocks%2Fcampaign*gemStripped=true*",
        "https://*.emarsys.net/bootstrap.php?*gemStripped=true*r=contentBlocks%2Fcampaign*",
        "https://*.emarsys.net//bootstrap.php?*r=contentBlocks/campaign*gemStripped=true*",
        "https://*.emarsys.net//bootstrap.php?*gemStripped=true*r=contentBlocks/campaign*",
        "https://*.emarsys.net//bootstrap.php?*r=contentBlocks%2Fcampaign*gemStripped=true*",
        "https://*.emarsys.net//bootstrap.php?*gemStripped=true*r=contentBlocks%2Fcampaign*"
      ],
      "css": ["css--campaign-stripped.css"],
      "js": ["campaign-stripped-readonly.js", "compare-email-basics-capture.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.emarsys.net/bootstrap.php?*r=contentBlocks/campaign*",
        "https://*.emarsys.net/bootstrap.php?*r=contentBlocks%2Fcampaign*",
        "https://*.emarsys.net//bootstrap.php?*r=contentBlocks/campaign*",
        "https://*.emarsys.net//bootstrap.php?*r=contentBlocks%2Fcampaign*"
      ],
      "exclude_matches": [
        "https://*.emarsys.net/bootstrap.php?*r=contentBlocks/campaign*gemStripped=true*",
        "https://*.emarsys.net/bootstrap.php?*gemStripped=true*r=contentBlocks/campaign*",
        "https://*.emarsys.net/bootstrap.php?*r=contentBlocks%2Fcampaign*gemStripped=true*",
        "https://*.emarsys.net/bootstrap.php?*gemStripped=true*r=contentBlocks%2Fcampaign*",
        "https://*.emarsys.net//bootstrap.php?*r=contentBlocks/campaign*gemStripped=true*",
        "https://*.emarsys.net//bootstrap.php?*gemStripped=true*r=contentBlocks/campaign*",
        "https://*.emarsys.net//bootstrap.php?*r=contentBlocks%2Fcampaign*gemStripped=true*",
        "https://*.emarsys.net//bootstrap.php?*gemStripped=true*r=contentBlocks%2Fcampaign*"
      ],
      "js": ["gem-focus-layout-boot.js"],
      "css": ["css--focus-layout.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.emarsys.net/bootstrap.php?*r=contentBlocks/campaign*",
        "https://*.emarsys.net/bootstrap.php?*r=contentBlocks%2Fcampaign*",
        "https://*.emarsys.net//bootstrap.php?*r=contentBlocks/campaign*",
        "https://*.emarsys.net//bootstrap.php?*r=contentBlocks%2Fcampaign*"
      ],
      "exclude_matches": [
        "https://*.emarsys.net/bootstrap.php?*r=contentBlocks/campaign*gemStripped=true*",
        "https://*.emarsys.net/bootstrap.php?*gemStripped=true*r=contentBlocks/campaign*",
        "https://*.emarsys.net/bootstrap.php?*r=contentBlocks%2Fcampaign*gemStripped=true*",
        "https://*.emarsys.net/bootstrap.php?*gemStripped=true*r=contentBlocks%2Fcampaign*",
        "https://*.emarsys.net//bootstrap.php?*r=contentBlocks/campaign*gemStripped=true*",
        "https://*.emarsys.net//bootstrap.php?*gemStripped=true*r=contentBlocks/campaign*",
        "https://*.emarsys.net//bootstrap.php?*r=contentBlocks%2Fcampaign*gemStripped=true*",
        "https://*.emarsys.net//bootstrap.php?*gemStripped=true*r=contentBlocks%2Fcampaign*"
      ],
      "js": ["gem-snippet-iframe-bridge.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.emarsys.net/bootstrap.php?*r=contentBlocks/campaign*",
        "https://*.emarsys.net/bootstrap.php?*r=contentBlocks%2Fcampaign*",
        "https://*.emarsys.net//bootstrap.php?*r=contentBlocks/campaign*",
        "https://*.emarsys.net//bootstrap.php?*r=contentBlocks%2Fcampaign*"
      ],
      "exclude_matches": [
        "https://*.emarsys.net/bootstrap.php?*r=contentBlocks/campaign*gemStripped=true*",
        "https://*.emarsys.net/bootstrap.php?*gemStripped=true*r=contentBlocks/campaign*",
        "https://*.emarsys.net/bootstrap.php?*r=contentBlocks%2Fcampaign*gemStripped=true*",
        "https://*.emarsys.net/bootstrap.php?*gemStripped=true*r=contentBlocks%2Fcampaign*",
        "https://*.emarsys.net//bootstrap.php?*r=contentBlocks/campaign*gemStripped=true*",
        "https://*.emarsys.net//bootstrap.php?*gemStripped=true*r=contentBlocks/campaign*",
        "https://*.emarsys.net//bootstrap.php?*r=contentBlocks%2Fcampaign*gemStripped=true*",
        "https://*.emarsys.net//bootstrap.php?*gemStripped=true*r=contentBlocks%2Fcampaign*"
      ],
      "js": ["debug-logging-gate.js", "platform.js", "gem-dom-watch.js", "gem-layer-stack.js", "alt-text-preview.js", "verticalnav-enhancer.js", "mobile-view.js", "textarea-expand.js", "text-highlighting.js", "color-swatch-manager.js", "keyboard-shortcuts.js", "language-load-overlay.js", "page-title-updater.js", "draft-save-indicator.js", "condensed-blocks-panel.js", "mobile-contact-preview.js", "lz-string.min.js", "snippet-storage.js", "favorite-image-storage.js", "gem-toast.js", "shortcut-slots.js", "content-block-toolbar.js", "header-copy-icon.js", "block-pinning.js", "sortable.min.js", "html2canvas.min.js", "share-screenshot.js", "contact-preview-screenshot.js", "overlay-panel-controls.js", "link-editor-recent-urls.js", "focus-layout.js", "snippets-tab.js", "find-replace-dom-utils.js", "find-replace-panel.js", "magic-fill-dom-utils.js", "magic-fill-panel.js", "subject-line-gemma-token-edit.js", "personalization-tokens.js", "snippet-context-menu.js", "preflight-panel.js", "keyword-swap.js", "custom-paste-loader.js", "campaign-draft-data-loader.js", "campaign-block-targeting.js", "esl-token-extractor.js", "compare-email-basics-capture.js", "compare-preview-common.js", "compare-languages.js", "compare-versions.js", "compare-esl-usage.js", "campaign-links-data.js", "review-links.js"],
      "css": ["css--styles.css", "css--e-panels.css", "css--focus-layout.css", "css--compare-languages.css", "css--share-screenshot.css", "css--snippet-context-menu.css", "css--find-replace-panel.css", "css--magic-fill-panel.css", "css--link-editor-recent-urls.css"]
    }
  ]
}
