{
  "name": "Gemma for Emarsys",
  "version": "5.3.0",
  "manifest_version": 3,
  "description": "Enhances the Emarsys email editor with a settings panel and more!",
  "permissions": ["storage", "tabs", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gemma for Emarsys"
  },
  "icons": {
    "512": "icons/icon-512x512.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["img/*"],
      "matches": ["https://*.emarsys.net/*"]
    }
  ],      
  "content_scripts": [
    {
      "matches": ["https://*.emarsys.net/*"], 
      "css": ["theme.css", "global-styles.css"],
      "js": ["platform.js", "settings-panel.js", "nav-menu-inject.js", "welcome-modal.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.emarsys.net/bootstrap.php?*r=MediaDB/popup*"], 
      "js": ["media-db-popup.js"],
      "css": ["MediaDB-popup.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.emarsys.net/bootstrap.php?*r=contentBlocks/campaign*"],
      "js": ["platform.js", "verticalnav-enhancer.js", "mobile-view.js", "textarea-expand.js", "text-highlighting.js", "color-swatch-manager.js", "keyboard-shortcuts.js", "toggle-page-elements.js", "page-title-updater.js", "condensed-blocks-panel.js", "mobile-contact-preview.js", "content-block-toolbar.js", "header-copy-icon.js", "block-pinning.js", "overlay-panel-controls.js", "expanded-mode.js", "snippets-tab.js", "keyword-swap.js"],
      "css": ["styles.css", "e-panels.css", "expanded-mode.css"]
    }
  ]
} 