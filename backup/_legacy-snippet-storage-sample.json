        "category": "Upgrades",
        "content": "{% foreach purchase in rds.emardata_rds.purchases(contact.5667) | reverse %}\n{% if purchase.purchase_state == 'active' %}\n{{ rds.emardata_rds.purchases(contact.5667)[0].following_period_in_months }}\n{% endif %}\n{% endforeach %}",
        "description": "For all emails. Returns a value in months.",
        "favorite": true,
        "id": "snippet-1770649127443-0e2e6q65u",
        "name": "Recurring period",
        "swapKeywords": []
    },
    {
        "category": "Upgrades",
        "content": "{% set monthly = 0 %}\n{% set break = false %}\n{% foreach purchase in rds.rds_babbel.purchases(contact.5667) | reverse %}\n{% if purchase.purchase_state == 'active' and purchase.price_recurring > current and not break %}\n{% set monthly = purchase.price_recurring / purchase.following_period_in_months %}\n${{ monthly | number_format(2, '.', ',') }}\n{% set break = true %}\n{% endif %}\n{% endforeach %}",
        "description": "(1-6M) For Price Per Month and no decimals use this.",
        "favorite": false,
        "id": "snippet-1770649272259-krrfo85j4",
        "name": "recurring price (1m-6m) (no decimals)",
        "swapKeywords": []
    },
    {
        "category": "Upgrades",
        "content": "{% set monthly = 0 %}\n{% set break = false %}\n{% foreach purchase in rds.rds_babbel.purchases(contact.5667) | reverse %}\n{% if purchase.purchase_state == 'active' and purchase.price_recurring > current and not break %}\n{% set monthly = purchase.price_recurring / purchase.following_period_in_months %}\n${{ monthly | number_format(2, '.', ',') }}\n{% set break = true %}\n{% endif %}\n{% endforeach %}",
