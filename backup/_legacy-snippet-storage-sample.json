    {
        "category": "Upgrades",
        "content": "{% foreach purchase in rds.emardata_rds.purchases(contact.5667) | reverse %}\n  {% if purchase.purchase_state == 'active' %}\n    {% if purchase.currency == 'EUR' %}\n    {{ purchase.price_recurring }} €\n    {% endif %}\n    {% if purchase.currency == 'GBP' %}\n    £{{ purchase.price_recurring }}\n    {% endif %}\n    {% if purchase.currency == 'CHF' %}\n    CHF{{ purchase.price_recurring }}\n    {% endif %}\n    {% if purchase.currency == 'SEK' %}\n    kr{{ purchase.price_recurring }}\n    {% endif %}\n    {% if purchase.currency == 'SEK' %}\n    kr{{ purchase.price_recurring }}\n    {% endif %}\n    {% if purchase.currency == 'PLN' %}\n    zł{{ purchase.price_recurring }}\n    {% endif %}\n    {% if purchase.currency != 'EUR' and purchase.currency != 'GBP' and purchase.currency != 'CHF' and purchase.currency != 'SEK' and purchase.currency != 'PLN' %}\n    ${{ purchase.price_recurring }}\n    {% endif %}\n  {% endif %}\n{% endforeach %}",
        "description": "(12M) For Recurring Price (per period) use this.",
